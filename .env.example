# Copy to .env (never committed) and point it at the same Neon database the
# mobile app (leetcode-app) uses.
#
# DATABASE_URL is the canonical name for this web app. EXPO_PUBLIC_NEON_URL is
# kept in sync so both apps can share one database.
#
# Get the pooled connection string from the Neon dashboard -> Connect.
# The mobile app inlines its value into the app bundle, so it uses a
# least-privilege `app_sync` role there. This web app runs the value server
# side only, so the owner role is acceptable for local development.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
EXPO_PUBLIC_NEON_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Optional. When set, the write API (server actions) requires
# "Authorization: Bearer <API_SECRET>". The browser UI uses its own
# same-origin session, so leave it unset for personal local use.
# API_SECRET=
